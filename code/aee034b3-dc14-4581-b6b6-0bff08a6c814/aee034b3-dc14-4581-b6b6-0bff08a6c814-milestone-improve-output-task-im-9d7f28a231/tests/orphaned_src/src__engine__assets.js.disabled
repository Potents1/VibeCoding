// Deterministic procedural assets (no external images). Keep pure functions only.

export function getPalette() {
  return {
    ceilingA: 0x0b1638,
    ceilingB: 0x040510,
    floorA: 0x07090f,
    floorB: 0x0b0f1f,

    fog: 0x0b0d18,

    // wall material base colors
    brickA: 0x8b2f2c,
    brickB: 0x5f1f1c,
    mortar: 0xbfa88e,

    metalA: 0x7c8aa8,
    metalB: 0x3c4760,
    rivet: 0xd0d7f0,

    techA: 0x2b5b7a,
    techB: 0x173247,
    glow: 0x47e6ff,

    enemyBody: 0xff4868,
    enemyShadow: 0x3a0c18,
    enemyEye: 0xfce7f3,

    weaponDark: 0x11162a,
    weaponMid: 0x3b4a72,
    weaponLight: 0x9fb0df,
    weaponGlow: 0xa7f3d0
  };
}

function clamp01(v) {
  return Math.max(0, Math.min(1, v));
}

export function colorToRgb(hex) {
  const r = (hex >> 16) & 255;
  const g = (hex >> 8) & 255;
  const b = hex & 255;
  return `rgb(${r},${g},${b})`;
}

export function colorLerp(a, b, t) {
  const ar = (a >> 16) & 255;
  const ag = (a >> 8) & 255;
  const ab = a & 255;
  const br = (b >> 16) & 255;
  const bg = (b >> 8) & 255;
  const bb = b & 255;
  const rr = Math.round(ar + (br - ar) * t);
  const rg = Math.round(ag + (bg - ag) * t);
  const rb = Math.round(ab + (bb - ab) * t);
  return (rr << 16) | (rg << 8) | rb;
}

function hash2i(x, y, seed) {
  let n = (x | 0) * 374761393 + (y | 0) * 668265263 + (seed | 0) * 1442695041;
  n = (n ^ (n >> 13)) * 1274126177;
  n ^= n >> 16;
  return (n >>> 0) / 4294967296;
}

function mulColor(hex, m) {
  const r = Math.min(255, Math.max(0, Math.round(((hex >> 16) & 255) * m)));
  const g = Math.min(255, Math.max(0, Math.round(((hex >> 8) & 255) * m)));
  const b = Math.min(255, Math.max(0, Math.round((hex & 255) * m)));
  return (r << 16) | (g << 8) | b;
}

export function sampleWallTex(pal, matId, u, v, side) {
  u = u - Math.floor(u);
  v = v - Math.floor(v);

  if (matId === 1) {
    const brickW = 0.25;
    const brickH = 0.125;
    const row = Math.floor(v / brickH);
    const offset = (row & 1) ? brickW * 0.5 : 0;
    const uu = (u + offset) % 1;

    const inMortar = (uu % brickW) < 0.02 || (v % brickH) < 0.02;
    if (inMortar) return pal.mortar;

    const bx = Math.floor(uu / brickW);
    const by = row;
    const n = hash2i(bx, by, 11);
    const base = n < 0.5 ? pal.brickA : pal.brickB;

    const grain = 0.86 + hash2i(Math.floor(u * 64), Math.floor(v * 64), 12) * 0.22;
    return mulColor(base, grain);
  }

  if (matId === 2) {
    const panel = (Math.floor(u * 4) + Math.floor(v * 4)) & 1;
    let c = panel ? pal.metalA : pal.metalB;

    const ux = Math.floor(u * 16);
    const vy = Math.floor(v * 16);
    const isRivet = ux % 8 === 0 && vy % 8 === 0;
    if (isRivet) c = pal.rivet;

    const scratches = hash2i(Math.floor(u * 64), Math.floor(v * 64), 21);
    if (scratches > 0.985) c = colorLerp(c, 0xffffff, 0.55);

    return c;
  }

  const gx = Math.floor(u * 8);
  const gy = Math.floor(v * 8);
  let c = ((gx + gy) & 1) ? pal.techA : pal.techB;

  if (Math.abs((u * 8) % 1 - 0.5) < 0.06) c = colorLerp(c, pal.glow, 0.75);

  const dot = hash2i(Math.floor(u * 48), Math.floor(v * 48), 33);
  if (dot > 0.992) c = colorLerp(c, pal.rivet, 0.55);

  if (side === 1) c = mulColor(c, 0.9);
  return c;
}

const ENEMY_W = 24;
const ENEMY_H = 32;
const ENEMY_PIXELS = (() => {
  const rows = [
    '000000000011110000000000',
    '000000001111111100000000',
    '000000011112221111000000',
    '000000111122222111100000',
    '000001111222222211110000',
    '000011111222222211111000',
    '000111111222222211111100',
    '000111111223332211111100',
    '001111112233333221111110',
    '001111122333333322111110',
    '001111122334443322111110',
    '001111122334443322111110',
    '001111122333333322111110',
    '001111112233333221111110',
    '000111111223332211111100',
    '000111111222222211111100',
    '000111112222222221111100',
    '000111122222222222111100',
    '000111122222222222111100',
    '000111122222222222111100',
    '000111112222222221111100',
    '000111111222222211111100',
    '000011111222222211111000',
    '000001111122222111110000',
    '000000111111111111100000',
    '000000011111111111000000',
    '000000001111111100000000',
    '000000000111111000000000',
    '000000000011110000000000',
    '000000000001100000000000',
    '000000000001100000000000',
    '000000000000000000000000'
  ];
  const arr = new Uint8Array(ENEMY_W * ENEMY_H);
  for (let y = 0; y < ENEMY_H; y += 1) {
    const r = rows[y];
    for (let x = 0; x < ENEMY_W; x += 1) arr[y * ENEMY_W + x] = r.charCodeAt(x) - 48;
  }
  return arr;
})();

export function getEnemySprite() {
  return { w: ENEMY_W, h: ENEMY_H, pixels: ENEMY_PIXELS };
}

const WEAPON_W = 96;
const WEAPON_H = 72;

function makeWeaponFrame(kick) {
  const px = new Uint8Array(WEAPON_W * WEAPON_H);
  const baseY = 40 + Math.round(kick * 6);
  const baseX = 22;

  function put(x, y, v) {
    if (x < 0 || y < 0 || x >= WEAPON_W || y >= WEAPON_H) return;
    px[y * WEAPON_W + x] = v;
  }

  for (let y = 0; y < 26; y += 1) {
    for (let x = 0; x < 56; x += 1) {
      const yy = baseY + y;
      const xx = baseX + x;
      if (y < 2 || y > 23 || x < 2 || x > 53) put(xx, yy, 2);
      else put(xx, yy, 3);
    }
  }

  for (let y = 0; y < 10; y += 1) {
    for (let x = 0; x < 34; x += 1) {
      const yy = baseY + 6 + y;
      const xx = baseX + 44 + x;
      put(xx, yy, x < 30 ? 2 : 1);
    }
  }

  if (kick > 0.2) {
    for (let y = 0; y < 8; y += 1) {
      for (let x = 0; x < 8; x += 1) {
        const yy = baseY + 7 + y;
        const xx = baseX + 72 + x;
        const d = Math.hypot(x - 3.5, y - 3.5);
        if (d < 3.5) put(xx, yy, 4);
      }
    }
  }

  for (let x = 6; x < 48; x += 1) put(baseX + x, baseY + 4, 1);

  return { w: WEAPON_W, h: WEAPON_H, pixels: px };
}

const WEAPON_FRAMES = [makeWeaponFrame(0), makeWeaponFrame(0.55), makeWeaponFrame(1)];

export function getWeaponFrames() {
  return WEAPON_FRAMES;
}

export function paletteIndexToColor(pal, idx, { hitFlash = false } = {}) {
  if (idx === 0) return null;
  if (idx === 1) return pal.enemyShadow;
  if (idx === 2) return hitFlash ? 0xffffff : pal.enemyBody;
  if (idx === 3) return hitFlash ? 0xfff1f2 : colorLerp(pal.enemyBody, 0x11162a, 0.35);
  if (idx === 4) return pal.enemyEye;
  return pal.enemyBody;
}

export function weaponIndexToColor(pal, idx) {
  if (idx === 0) return null;
  if (idx === 1) return pal.weaponLight;
  if (idx === 2) return pal.weaponMid;
  if (idx === 3) return pal.weaponDark;
  if (idx === 4) return pal.weaponGlow;
  return pal.weaponMid;
}

export function applyFog(pal, color, shade) {
  const t = clamp01(shade);
  return colorLerp(pal.fog, color, t);
}

export function materialForCell(cellX, cellY) {
  const n = hash2i(cellX, cellY, 99);
  if (n < 0.34) return 1;
  if (n < 0.68) return 2;
  return 3;
}

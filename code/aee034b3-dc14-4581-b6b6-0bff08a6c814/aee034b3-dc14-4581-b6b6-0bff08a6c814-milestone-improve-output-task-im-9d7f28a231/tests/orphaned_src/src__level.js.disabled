import { TILE, WORLD_H, WORLD_W } from "./constants.js";

export function makeDefaultLevel() {
  const walls = [];

  walls.push({ x: 0, y: 0, w: WORLD_W, h: 2 });
  walls.push({ x: 0, y: WORLD_H - 2, w: WORLD_W, h: 2 });
  walls.push({ x: 0, y: 0, w: 2, h: WORLD_H });
  walls.push({ x: WORLD_W - 2, y: 0, w: 2, h: WORLD_H });

  for (let i = 0; i < 9; i++) {
    walls.push({ x: 20 + i * 14, y: 18, w: 2, h: 36 });
  }
  walls.push({ x: 15, y: 60, w: 60, h: 2 });
  walls.push({ x: 80, y: 30, w: 60, h: 2 });

  const spawn = { x: 10, y: 10 };
  const goal = { x: WORLD_W - 12, y: WORLD_H - 12 };

  const droneSpawns = [
    { x: 42, y: 12, dir: { x: 1, y: 0 }, min: 30, max: 120 },
    { x: 120, y: 26, dir: { x: 0, y: 1 }, min: 10, max: 80 },
    { x: 70, y: 72, dir: { x: 1, y: 0 }, min: 20, max: 140 }
  ];

  const grid = {
    tile: TILE,
    w: Math.floor(WORLD_W / TILE),
    h: Math.floor(WORLD_H / TILE)
  };

  return { walls, spawn, goal, droneSpawns, grid };
}
